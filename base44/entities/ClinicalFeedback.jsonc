{
  "name": "ClinicalFeedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Pharmacy Feedback",
        "Doctor Request",
        "Stock Alert",
        "Substitution Suggestion"
      ],
      "default": "Pharmacy Feedback"
    },
    "from_user_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "from_role": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string",
      "description": "Dokter tujuan (untuk Pharmacy Feedback)"
    },
    "to_name": {
      "type": "string"
    },
    "to_role": {
      "type": "string",
      "default": "Dokter"
    },
    "prescription_id": {
      "type": "string"
    },
    "medicine_id": {
      "type": "string"
    },
    "medicine_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "alternative_medicine_name": {
      "type": "string",
      "description": "Alternatif yang tersedia (untuk Substitution Suggestion)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Baru",
        "Dibaca",
        "Direview",
        "Selesai",
        "Ditolak"
      ],
      "default": "Baru"
    },
    "review_action": {
      "type": "string",
      "description": "Tindakan dokter: Setujui Substitusi, Tolak, Ajukan Obat Lain"
    },
    "review_notes": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "from_name",
    "subject",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}