{
  "name": "RequiredDocument",
  "type": "object",
  "properties": {
    "owner_type": {
      "type": "string",
      "enum": [
        "Dokter",
        "Staf",
        "Pasien",
        "Peralatan",
        "Klinik",
        "Supplier"
      ],
      "description": "Jenis data pemilik dokumen wajib"
    },
    "clinic_role": {
      "type": "string",
      "description": "Jabatan yang wajib memiliki dokumen ini (untuk Dokter/Staf)"
    },
    "document_name": {
      "type": "string",
      "description": "Nama dokumen wajib, mis. CV, STR, SIP, Kontrak"
    },
    "category": {
      "type": "string",
      "description": "Kategori pengelompokan, mis. Identitas, Izin & Profesi, Kerja Sama"
    },
    "has_expiry": {
      "type": "boolean",
      "default": false,
      "description": "True jika dokumen ini memiliki masa berlaku"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "owner_type",
    "document_name",
    "is_active"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Owner"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Owner"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}