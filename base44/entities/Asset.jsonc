{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Medis",
        "Kantor",
        "IT",
        "Fasilitas",
        "Lainnya"
      ],
      "default": "Kantor"
    },
    "location": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_value": {
      "type": "number",
      "default": 0
    },
    "condition": {
      "type": "string",
      "enum": [
        "Baik",
        "Perlu Servis",
        "Rusak",
        "Pensiun"
      ],
      "default": "Baik"
    },
    "last_maintenance": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}