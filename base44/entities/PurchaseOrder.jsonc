{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Menunggu Approval",
        "Disetujui",
        "Dikirim",
        "Diterima Sebagian",
        "Diterima",
        "Dibatalkan"
      ],
      "default": "Draft"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Menunggu Approval",
        "Disetujui",
        "Ditolak"
      ],
      "default": "Draft",
      "description": "Status approval berjenjang: Draft \u2192 Menunggu Approval \u2192 Disetujui/Ditolak"
    },
    "approved_by": {
      "type": "string",
      "description": "Nama apoteker yang menyetujui SP"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "is_narcotic_po": {
      "type": "boolean",
      "default": false,
      "description": "True jika SP untuk narkotika/psikotropika (form terpisah)"
    },
    "narcotic_form_number": {
      "type": "string",
      "description": "Nomor form SP narkotika terpisah, mis. SPN-2026-001"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medicine_id": {
            "type": "string"
          },
          "medicine_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "received_quantity": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "po_number",
    "supplier_id",
    "supplier_name",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Apoteker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.clinic_role": "Apoteker"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}