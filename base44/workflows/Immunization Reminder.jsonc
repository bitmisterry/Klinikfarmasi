{
  "description": "Cek harian vaksin terlewat pada pasien anak dan buat notifikasi untuk dokter anak",
  "name": "Immunization Reminder",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "immunization_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkImmunizationReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Cek Imunisasi Terlewat",
            "description": "Scan pasien anak & buat notifikasi"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}